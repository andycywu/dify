# REST to SOAP Proxy Server Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# SOAP API 認證 (用於 SOAP 模式)
# ============================================
# Application ID for authenticating with the SOAP service
APP_ID=your_app_id_here

# API Password for authenticating with the SOAP service  
API_PWD=your_api_password_here

# ============================================
# HTTPS 模式認證 (用於 HTTPS 模式)
# ============================================
# Urtracker 用戶名和密碼
# 這些用於 VBA 風格的 HTTPS 登入
# 注意：不要直接在 .env 中存儲密碼，建議通過 API 調用時傳遞
# URTRACKER_USERNAME=your_username
# URTRACKER_PASSWORD=your_password

# ============================================
# 服務器配置
# ============================================
# Port number for the REST proxy server (default: 5001)
PORT=5001

# Node environment (development, production)
NODE_ENV=development

# ============================================
# Urtracker 配置
# ============================================
# Optional: Override WSDL URL if needed
# WSDL_URL=https://fwtrack.tpv-tech.com/api/issue.asmx

# Optional: Override base URL for HTTPS client
# URTRACKER_BASE_URL=https://fwtrack.tpv-tech.com

# ============================================
# Session 配置 (可選)
# ============================================
# Session timeout in milliseconds (default: 3600000 = 1 hour)
# SESSION_TIMEOUT=3600000

# Session secret for cookie signing
# SESSION_SECRET=your-secret-key-here

