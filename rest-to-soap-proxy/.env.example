# REST to SOAP Proxy Server Environment Configuration
# Copy this file to .env and fill in your actual values

# SOAP API Credentials
# Application ID for authenticating with the SOAP service
APP_ID=your_app_id_here

# API Password for authenticating with the SOAP service  
API_PWD=your_api_password_here

# Server Configuration
# Port number for the REST proxy server (default: 5001)
PORT=5001

# Optional: Override WSDL URL if needed
# WSDL_URL=https://fwtrack.tpv-tech.com/api/issue.asmx
