# Tilt Development Environment Configuration
# This file contains environment variables specifically for Tilt.dev development

# =============================================================================
# DEVELOPMENT PROFILES
# =============================================================================
# Available profiles: minimal, default, full
# - minimal: Only core services (API, DB, Redis)
# - default: Core services + vector store (Weaviate)
# - full: All services including Wiki, Plugin Daemon, etc.

TILT_PROFILE=default
TILT_ENABLE_DEBUG=false
TILT_LIVE_RELOAD=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_DATABASE=dify

# Plugin Database
DB_PLUGIN_DATABASE=dify_plugin

# Wiki Database
WIKI_DB_NAME=wiki
WIKI_DB_USER=wiki_app
WIKI_DB_PASSWORD=wiki_pass

# =============================================================================
# REDIS CONFIGURATION  
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=difyai123456
REDIS_DB=0

# Celery Redis DB
CELERY_REDIS_DB=1

# =============================================================================
# VECTOR STORE CONFIGURATION
# =============================================================================
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
SECRET_KEY=sk-9f73s3ljTXVcMT3Blb3ljTqtsKiGHXVcMT3BlbkFJLK7U
LOG_LEVEL=INFO
FLASK_DEBUG=false

# API Configuration
DIFY_BIND_ADDRESS=0.0.0.0
DIFY_PORT=5001
MODE=api

# Celery Configuration
CELERY_BROKER_URL=redis://:difyai123456@redis:6379/1
CELERY_BACKEND=redis
CELERY_WORKER_AMOUNT=1
CELERY_WORKER_CLASS=gevent

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
STORAGE_TYPE=opendal
OPENDAL_SCHEME=fs
OPENDAL_FS_ROOT=storage

# =============================================================================
# EXTERNAL SERVICES CONFIGURATION
# =============================================================================
# OpenAI Configuration (Optional)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

# Code Execution (Sandbox)
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
CODE_EXECUTION_API_KEY=dify-sandbox

# =============================================================================
# DEVELOPMENT SPECIFIC SETTINGS
# =============================================================================
# Disable telemetry in development
NEXT_TELEMETRY_DISABLED=1
SCARF_NO_ANALYTICS=true

# Enable CORS for development
WEB_API_CORS_ALLOW_ORIGINS=*
CONSOLE_CORS_ALLOW_ORIGINS=*

# Debug settings
DEBUG=false
ENABLE_REQUEST_LOGGING=false

# Migration settings
MIGRATION_ENABLED=true

# =============================================================================
# PLUGIN CONFIGURATION
# =============================================================================
PLUGIN_DAEMON_PORT=5002
PLUGIN_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
PLUGIN_DAEMON_URL=http://plugin-daemon:5002
PLUGIN_MAX_PACKAGE_SIZE=52428800
PLUGIN_DEBUGGING_HOST=0.0.0.0
PLUGIN_DEBUGGING_PORT=5003

# =============================================================================
# WIKI CONFIGURATION
# =============================================================================
WIKI_PORT=3002
WIKI_ADMIN_EMAIL=admin@example.com
WIKI_HOST=http://localhost:3002
WIKI_API_KEY=

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
# These ports are used by Tilt for port forwarding
EXPOSE_API_PORT=5001
EXPOSE_WEB_PORT=3000
EXPOSE_NEXT_FRONTEND_PORT=3001
EXPOSE_WIKI_PORT=3002
EXPOSE_POSTGRES_PORT=5432
EXPOSE_REDIS_PORT=6379
EXPOSE_WEAVIATE_PORT=8080
EXPOSE_PLUGIN_DAEMON_PORT=5002
EXPOSE_PLUGIN_DEBUGGING_PORT=5003