# ===========================================
# dify-next-frontend - 生產環境配置模板
# ===========================================

# ============================================
# 容器內部服務通信（Docker 網路內部）
# 注意：容器間調用在任何環境下都使用相同的 Docker 服務名
# ============================================

# --- 內部 API 配置 ---
API_URL=http://api:5001
DATABASE_URL=postgresql://postgres:PRODUCTION_DB_PASSWORD@db:5432/wiki

# --- Wiki.js 內部整合配置 ---
WIKI_GRAPHQL_URL=http://wiki:3000/graphql
WIKI_URL=http://wiki:3000

# --- Ollama 配置（外部本地服務）---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 應用運行配置 ---
NODE_ENV=production
PORT=3000

# ============================================
# 容器外部變數（用於瀏覽器訪問）
# ============================================

# ⚠️ 生產環境域名配置 - 部署時必須手動修改
NEXT_PUBLIC_HOST=localhost
NEXT_PUBLIC_PORT=80
NEXT_PUBLIC_PROTOCOL=http

# --- 外部 API 端點（基於上述配置自動構建）---
NEXT_PUBLIC_DIFY_API_BASE_URL=http://localhost/v1
NEXT_PUBLIC_WIKI_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_PANEL_URL=http://localhost:3001

# --- 認證回調 URL ---
NEXTAUTH_URL=http://localhost:3000

# ============================================
# 安全配置（必須在部署時手動替換所有 DUMMY 值）
# ============================================

# ⚠️ 以下所有安全密鑰都是 DUMMY 值，生產環境部署時必須全部替換！

# NextAuth 認證密鑰 (使用 openssl rand -base64 32 生成)
NEXTAUTH_SECRET=PRODUCTION-NEXTAUTH-SECRET-REPLACE-WITH-SECURE-KEY

# JWT 配置 (使用 openssl rand -base64 32 生成)
JWT_SECRET=PRODUCTION-JWT-SECRET-REPLACE-WITH-SECURE-KEY
JWT_EXPIRES_IN=7d

# 應用密鑰 (使用 openssl rand -base64 32 生成)
SECRET_KEY=PRODUCTION-APP-SECRET-REPLACE-WITH-SECURE-KEY

# Wiki API 密鑰 (從 Wiki.js 管理界面獲取)
WIKI_API_KEY=PRODUCTION-WIKI-API-KEY-FROM-WIKIJS-ADMIN

# Dify API 密鑰 (從 Dify 管理界面獲取)
NEXT_PUBLIC_DIFY_API_KEY=PRODUCTION-DIFY-API-KEY-FROM-DIFY-ADMIN

# Dify DataSet 密鑰 (從 Dify 管理界面獲取)
NEXT_PUBLIC_DIFY_DATASET_KEY=PRODUCTION-DIFY-DATASET-KEY-FROM-DIFY-ADMIN

# ============================================
# 生產環境管理員配置（部署時必須移除或替換）
# ============================================

# ⚠️ 生產環境請移除或設置安全的管理員帳號
NEXT_PUBLIC_DEFAULT_ADMIN_USERNAME=
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=

# ============================================
# 生產環境優化配置
# ============================================

# --- 安全與性能配置 ---
HTTPS=true
NEXT_TELEMETRY_DISABLED=1
GENERATE_SOURCEMAP=false
LOG_LEVEL=warn
LOG_FORMAT=json

# --- SSL 證書配置（如果需要）---
SSL_KEY_PATH=
SSL_CERT_PATH=

# --- 功能開關 ---
NEXT_PUBLIC_ENABLE_CHAT_CITATION_AND_SUGGESTED_QUESTIONS=true