# Frontend Environment Configuration for Docker/AWS Deployment
# This file is used when running in Docker containers

# Next.js 前端自身的配置 - Docker 環境
APP_API_URL=http://api:5001
APP_WEB_URL=http://localhost:3001
FILES_URL=http://api:5001/files
NEXT_PUBLIC_API_URL=http://api:5001
NEXT_PUBLIC_AUTH_URL=http://localhost:3001/api/auth
NEXTAUTH_URL=http://localhost:3001
API_URL=http://api:5001

# Dify 後端 API 配置
NEXT_PUBLIC_DIFY_API_BASE_URL=http://api:5001/v1
NEXT_PUBLIC_ADMIN_API_KEY=app-your-api-key-here
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://api:5001/v1

# 安全配置 - 使用強密碼和隨機密鑰
