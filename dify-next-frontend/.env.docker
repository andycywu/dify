# --- 功能開關 ---
NEXT_PUBLIC_ENABLE_CHAT_CITATION_AND_SUGGESTED_QUESTIONS=true

# ============================================
# Wiki.js → Dify 同步系統環境變數
# ============================================

# Dify API 配置（伺服器端使用）
DIFY_API_URL=http://api:5001/v1

# ============================================
# Dify Dataset IDs（10 個部門知識庫）
# ============================================

# 1. COMMON - 公共知識庫
DIFY_DATASET_COMMON_ID=ab29375f-c25f-4768-b8f9-5c94b61f6cd5

# 2. DQE - 設計品質工程
DIFY_DATASET_DQE_ID=85f623b3-919c-4ea8-93c3-c06b2b03e10d

# 3. DQE_CERTI - DQE 認證
DIFY_DATASET_DQE_CERTI_ID=c180dc8a-2e43-4ba8-bc69-20c41ecb0084

# 4. HW - 硬體部門
DIFY_DATASET_HW_ID=a5dccf76-7c8f-4bea-9e5a-4cdaab83a270

# 5. PWR - 電源部門
DIFY_DATASET_PWR_ID=621779eb-889b-4d7e-97ce-bf9d9175df2b

# 6. ME_LCM - 機械生命週期管理
DIFY_DATASET_ME_LCM_ID=e83d2be9-69cd-480d-b5e1-3273a805e32e

# 7. SW - 軟體部門
DIFY_DATASET_SW_ID=cb93e26b-f06e-4a4a-a396-1581efdaab18

# 8. PJM - 專案管理
DIFY_DATASET_PJM_ID=39fb29a4-c830-44df-9397-bbf2f64199e3

# 9. ARCH - 架構部門
DIFY_DATASET_ARCH_ID=917d8b89-356a-4a98-9ffd-692b4d79a98b

# 10. TM - 測試管理
DIFY_DATASET_TM_ID=1ab6e9b7-499d-4ead-bb53-c56a27210eb6

# ============================================
# 如何取得 Dataset ID？
# ============================================
# 1. 登入 Dify Console
# 2. 進入「知識庫 / Datasets」
# 3. 點開任一 Dataset
# 4. 從網址複製 dataset_id
#    例如：https://your-dify/datasets/12345678-abcd-1234-5678-xxxxxxxxxxxx/documents
#    這裡的 12345678-abcd-1234-5678-xxxxxxxxxxxx 就是 dataset_id
