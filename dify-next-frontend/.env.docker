# ===========================================
# dify-next-frontend - Docker 容器環境配置
# ===========================================

# ============================================
# 容器內部服務通信（Docker 網路內部）
# ============================================

# --- 內部 API 配置 ---
API_URL=http://api:5001/v1
DATABASE_URL=postgresql://postgres:difyai123456@db:5432/wiki

# --- Dify 數據庫配置 ---
DIFY_DATABASE_URL=postgresql://postgres:difyai123456@db:5432/dify

# --- Wiki.js 內部整合配置 ---
# Wiki.js GraphQL API (Docker 內部用 wiki:3000, 外部用 172.27.197.100:3002)
WIKI_GRAPHQL_URL=http://172.27.197.100:3002/graphql

# --- Ollama 配置（外部本地服務）---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 應用運行配置 ---
NODE_ENV=development
PORT=3000

# ============================================
# Dify API 配置（直接調用原生API，無代理）
# ============================================

# 直接指向 Dify 原生 API 端點（通過 nginx）
NEXT_PUBLIC_DIFY_API_BASE_URL=http://172.27.197.100/v1

# REST-to-SOAP 代理服務 URL（伺服器端使用）
REST_TO_SOAP_PROXY_URL=http://rest-to-soap-proxy:5001

# 認證回調 URL
NEXTAUTH_URL=http://172.27.197.100:3001
API_BASE_URL=http://dify-next-frontend:3001/api

# ============================================
# 安全配置（DUMMY 值 - 部署時必須手動修改）
# ============================================

# ⚠️ 以下為 DUMMY 安全密鑰，部署到生產環境時必須手動替換！

# NextAuth 認證密鑰 (使用開發環境密鑰)
NEXTAUTH_SECRET=dev-nextauth-secret-key-change-in-production

# JWT 配置 (使用開發環境密鑰)
JWT_SECRET=dify-wiki-integration-dev-secret
JWT_EXPIRES_IN=7d

# 應用密鑰 (使用開發環境密鑰)
SECRET_KEY=dev-secret-key-change-in-production

###############################################
