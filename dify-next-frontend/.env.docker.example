# ===========================================
# dify-next-frontend - Docker 容器環境配置範例
# ===========================================

# 使用方法：複製此檔案為 .env.docker 並修改相應配置

# ============================================
# 容器內部服務通信（Docker 網路內部）
# ============================================

# --- 內部 API 配置 ---
API_URL=http://api:5001
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db:5432/wiki

# --- Dify 數據庫配置 ---
DIFY_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db:5432/dify

# --- Wiki.js 內部整合配置 ---
WIKI_GRAPHQL_URL=http://wiki:3000/graphql

# --- Ollama 配置（外部本地服務）---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 應用運行配置 ---
NODE_ENV=development
PORT=3000

# ============================================
# Dify API 配置（直接調用原生API，無代理）
# ============================================

# 直接指向 Dify 原生 API 端點（通過 nginx）
NEXT_PUBLIC_DIFY_API_BASE_URL=http://localhost/v1

# 認證回調 URL
NEXTAUTH_URL=http://localhost:3001

# ============================================
# 安全配置（請修改為您的實際值）
# ============================================

# ⚠️ 以下為範例值，部署時必須手動替換為實際值！

# NextAuth 認證密鑰 (請生成您的密鑰)
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_KEY_HERE

# JWT 配置 (請生成您的密鑰)
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_EXPIRES_IN=7d

# 應用密鑰 (請生成您的密鑰)
SECRET_KEY=YOUR_SECRET_KEY_HERE

# Wiki API 密鑰 (從您的 Wiki.js 管理後台取得)
WIKI_API_KEY=YOUR_WIKI_API_KEY_HERE

# Dify API 密鑰 (從您的 Dify 控制台取得)
NEXT_PUBLIC_DIFY_API_KEY=YOUR_DIFY_API_KEY_HERE
NEXT_PUBLIC_DIFY_DATASET_KEY=YOUR_DIFY_DATASET_KEY_HERE

# ============================================
# 開發/測試用配置
# ============================================

# --- 預設管理員帳號（請修改密碼）---
NEXT_PUBLIC_DEFAULT_ADMIN_USERNAME=Administrator
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# --- 功能開關 ---
NEXT_PUBLIC_ENABLE_CHAT_CITATION_AND_SUGGESTED_QUESTIONS=true

# ============================================
# Wiki.js → Dify 同步系統環境變數
# ============================================

# Wiki.js API 配置
WIKI_API_KEY=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_TOKEN_HERE
WIKI_GRAPHQL_URL=http://wiki:3000/graphql

# Dify API 配置
DIFY_API_URL=http://api:5001/v1
DIFY_ADMIN_API_KEY=dataset-xxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Dify Dataset IDs（10 個部門知識庫）
# ============================================

# 1. COMMON - 公共知識庫
DIFY_DATASET_COMMON_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 2. DQE - 設計品質工程
DIFY_DATASET_DQE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 3. DQE_CERTI - DQE 認證
DIFY_DATASET_DQE_CERTI_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 4. HW - 硬體部門
DIFY_DATASET_HW_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 5. PWR - 電源部門
DIFY_DATASET_PWR_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 6. ME_LCM - 機械生命週期管理
DIFY_DATASET_ME_LCM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 7. SW - 軟體部門
DIFY_DATASET_SW_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 8. PJM - 專案管理
DIFY_DATASET_PJM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 9. ARCH - 架構部門
DIFY_DATASET_ARCH_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 10. TM - 測試管理
DIFY_DATASET_TM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================
# 如何取得 Dataset ID？
# ============================================
# 1. 登入 Dify Console
# 2. 進入「知識庫 / Datasets」
# 3. 點開任一 Dataset
# 4. 從網址複製 dataset_id
#    例如：https://your-dify/datasets/12345678-abcd-1234-5678-xxxxxxxxxxxx/documents
#    這裡的 12345678-abcd-1234-5678-xxxxxxxxxxxx 就是 dataset_id

NEXT_PUBLIC_WIKI_BATCH_IMPORTER_URL=http://172.27.197.100:5050
