# ===========================================
# dify-next-frontend - 生產環境配置模板
# ===========================================

# ============================================
# 容器內部服務通信（Docker 網路內部）
# 注意：容器間調用在任何環境下都使用相同的 Docker 服務名
# ============================================

# --- 內部 API 配置 ---
API_URL=http://api:5001
DATABASE_URL=postgresql://postgres:PRODUCTION_DB_PASSWORD@db:5432/wiki

# --- Wiki.js 內部整合配置 ---
WIKI_GRAPHQL_URL=http://wiki:3000/graphql

# --- Ollama 配置（外部本地服務）---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 應用運行配置 ---
NODE_ENV=production
PORT=3000

# ============================================
# 容器外部訪問（瀏覽器端）- 部署時修改
# ============================================

# ⚠️ 部署時必須修改為實際域名
NEXT_PUBLIC_DIFY_API_BASE_URL=https://YOUR_PRODUCTION_DOMAIN.com/v1
NEXTAUTH_URL=https://YOUR_PRODUCTION_DOMAIN.com:3001

# ============================================
# 安全配置（部署時必須替換所有密鑰）
# ============================================

# ⚠️ 使用 openssl rand -base64 32 生成
NEXTAUTH_SECRET=PRODUCTION-NEXTAUTH-SECRET-REPLACE-WITH-SECURE-KEY
JWT_SECRET=PRODUCTION-JWT-SECRET-REPLACE-WITH-SECURE-KEY
SECRET_KEY=PRODUCTION-APP-SECRET-REPLACE-WITH-SECURE-KEY

# ⚠️ 從實際服務獲取
WIKI_API_KEY=PRODUCTION-WIKI-API-KEY-FROM-WIKIJS-ADMIN
NEXT_PUBLIC_DIFY_API_KEY=PRODUCTION-DIFY-API-KEY-FROM-DIFY-ADMIN
NEXT_PUBLIC_DIFY_DATASET_KEY=PRODUCTION-DIFY-DATASET-KEY-FROM-DIFY-ADMIN

# ============================================
# 生產環境管理員配置（建議移除）
# ============================================

NEXT_PUBLIC_DEFAULT_ADMIN_USERNAME=
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=

# --- 功能開關 ---
NEXT_PUBLIC_ENABLE_CHAT_CITATION_AND_SUGGESTED_QUESTIONS=true