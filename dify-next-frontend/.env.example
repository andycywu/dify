# Frontend Environment Configuration Template
# Copy this file to .env.production/.env.development/.env.aws and fill in your actual values
# DO NOT commit the actual .env files to git!

# Next.js 前端自身的配置
APP_API_URL=https://api.dify.ai
APP_WEB_URL=https://dify.ai
FILES_URL=https://files.dify.ai
NEXT_PUBLIC_API_URL=https://api.dify.ai
NEXT_PUBLIC_AUTH_URL=https://auth.dify.ai
NEXTAUTH_URL=https://dify.ai
API_URL=http://localhost:5000/api

# Dify 後端 API 配置
NEXT_PUBLIC_DIFY_API_BASE_URL=https://api.dify.ai/v1
NEXT_PUBLIC_ADMIN_API_KEY=your_admin_api_key_here
NEXT_PUBLIC_ADMIN_API_BASE_URL=https://api.dify.ai/v1

# 安全配置 - 請使用強密碼和隨機密鑰
SECRET_KEY=your_secret_key_here
NODE_ENV=development
PORT=3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# 管理員配置 - 請修改預設密碼
NEXT_PUBLIC_DEFAULT_ADMIN_USERNAME=admin
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=your_secure_password_here

# API 配置
NEXT_PUBLIC_DIFY_API_KEY=your_dify_api_key_here
NEXT_PUBLIC_ENABLE_CHAT_CITATION_AND_SUGGESTED_QUESTIONS=true

# 資料庫配置
DATABASE_URL="file:./prisma/dev.db"

# 其他配置
NEXT_PUBLIC_USAGE_URL=https://usage.dify.ai

# Google OAuth 登入（如需啟用）
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here