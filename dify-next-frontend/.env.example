# Frontend environment template
# Copy to .env.docker / .env.local and adjust for your environment.

# --- Hosting / routing ---
CUSTOM_FRONTEND_BASE_PATH=/custom
CUSTOM_FRONTEND_EXTERNAL_ORIGIN=http://localhost
NEXT_PUBLIC_BASE_PATH=/custom

# --- Public URLs exposed to the browser ---
NEXT_PUBLIC_API_URL=/custom/api
NEXT_PUBLIC_DIFY_API_BASE_URL=http://localhost/api/v1
NEXT_PUBLIC_DIFY_API_KEY=
NEXT_PUBLIC_AUTH_URL=http://localhost/custom
NEXT_PUBLIC_USAGE_URL=http://localhost/custom/usage
NEXT_PUBLIC_ENABLE_CHAT_CITATION_AND_SUGGESTED_QUESTIONS=true

# --- Server-side integrations ---
API_URL=http://api:5001
APP_API_URL=http://localhost/api/v1
APP_WEB_URL=http://localhost/custom
FILES_URL=http://localhost/api/files

# --- Authentication ---
NEXTAUTH_URL=http://localhost/custom
NEXTAUTH_SECRET=your_nextauth_secret_here
SECRET_KEY=your_secret_key_here
NEXT_PUBLIC_DEFAULT_ADMIN_USERNAME=admin
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=dify12345

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL="file:./prisma/dev.db"

# --- Optional OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
