# ===========================================
# dify-next-frontend - 本地開發環境配置
# ===========================================

# ============================================
# 容器內部服務通信（Docker 網路內部）
# 注意：即使是本地開發，如果在容器內運行也要使用 Docker 服務名
# ============================================

# --- 內部 API 配置 ---
API_URL=http://api:5001
DATABASE_URL=postgresql://postgres:difyai123456@db:5432/wiki

# --- Wiki.js 內部整合配置 ---
WIKI_GRAPHQL_URL=http://wiki:3000/graphql
WIKI_URL=http://wiki:3000

# --- Ollama 配置（外部本地服務）---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 應用運行配置 ---
NODE_ENV=development
PORT=3000

# ============================================
# 外部訪問配置
# ============================================

# --- 外部 API 端點 ---
NEXT_PUBLIC_DIFY_API_BASE_URL=http://localhost/v1
NEXT_PUBLIC_WIKI_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_PANEL_URL=http://localhost:3001

# --- 認證回調 URL ---
NEXTAUTH_URL=http://localhost:3000

# ============================================
# 安全配置（DUMMY 值 - 部署時必須手動修改）
# ============================================

# ⚠️ 以下為 DUMMY 開發密鑰，生產環境時必須手動替換！

# NextAuth 認證密鑰 (生產環境必須替換)
NEXTAUTH_SECRET=dev-nextauth-secret-12345-very-long-secret-key-for-development

# JWT 配置 (生產環境必須替換)
JWT_SECRET=dev-jwt-secret-12345-very-long-secret-key-for-development
JWT_EXPIRES_IN=7d

# 應用密鑰 (生產環境必須替換)
SECRET_KEY=DUMMY-dev-secret-REPLACE-IN-PRODUCTION

# Wiki API 密鑰 (生產環境必須替換)
WIKI_API_KEY=DUMMY-dev-wiki-api-key-REPLACE-IN-PRODUCTION

# Dify API 密鑰 (生產環境必須替換)
NEXT_PUBLIC_DIFY_API_KEY=DUMMY-dev-dify-api-key-REPLACE-IN-PRODUCTION

# Dify DataSet 密鑰 (生產環境必須替換)
NEXT_PUBLIC_DIFY_DATASET_KEY=DUMMY-dev-dataset-key-REPLACE-IN-PRODUCTION

# ============================================
# 部門知識庫 API 密鑰（生產環境必須配置）
# ============================================
DIFY_ADMINISTRATORS_API_KEY=app-your-administrators-api-key
DIFY_GUESTS_API_KEY=app-your-guests-api-key
DIFY_EE_API_KEY=app-your-ee-api-key
DIFY_ME_LCM_API_KEY=app-your-me-lcm-api-key
DIFY_PWR_API_KEY=app-your-pwr-api-key
DIFY_SW_API_KEY=app-your-sw-api-key
DIFY_PJM_API_KEY=app-your-pjm-api-key

# ============================================
# 開發/測試用配置（可保留 DUMMY 值）
# ============================================

# --- 預設管理員帳號（僅用於開發/測試）---
NEXT_PUBLIC_DEFAULT_ADMIN_USERNAME=admin
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=dify12345

# --- 功能開關 ---
NEXT_PUBLIC_ENABLE_CHAT_CITATION_AND_SUGGESTED_QUESTIONS=true
