# ===========================================
# dify-next-frontend - 本地開發環境配置
# ===========================================

# ============================================
# 容器內部服務通信（Docker 網路內部）
# 注意：即使是本地開發，如果在容器內運行也要使用 Docker 服務名
# ============================================

# --- 內部 API 配置 ---
API_URL=http://api:5001/v1
DATABASE_URL=postgresql://postgres:difyai123456@172.27.197.100:5432/wiki

# --- Dify 數據庫配置 ---
DIFY_DATABASE_URL=postgresql://postgres:difyai123456@db:5432/dify

# --- Wiki.js 內部整合配置 ---
WIKI_GRAPHQL_URL=http://wiki:3000/graphql
WIKI_URL=http://wiki:3000

# --- Ollama 配置（外部本地服務）---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 應用運行配置 ---
NODE_ENV=development
PORT=3000

# ============================================
# 外部訪問配置
# ============================================

# --- 外部 API 端點 ---
NEXT_PUBLIC_DIFY_API_BASE_URL=http://172.27.197.100/v1
NEXT_PUBLIC_WIKI_URL=http://172.27.197.100:3002
