# Docker Registry 配置
# 請根據您使用的 registry 修改以下配置

# Docker Hub (例如: your-username)
DOCKER_REGISTRY=your-registry

# AWS ECR (例如: 123456789012.dkr.ecr.us-west-2.amazonaws.com)
# DOCKER_REGISTRY=your-account.dkr.ecr.region.amazonaws.com

# GitHub Container Registry (例如: ghcr.io/your-username)
# DOCKER_REGISTRY=ghcr.io/your-username

# Google Container Registry (例如: gcr.io/your-project-id)
# DOCKER_REGISTRY=gcr.io/your-project-id

# Image Tag
IMAGE_TAG=latest

# 構建相關配置
BUILD_NO_CACHE=false
