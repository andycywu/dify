# Docker Registry 配置
# 請根據您使用的 registry 修改以下配置

# Docker Hub (例如: your-username)
DOCKER_REGISTRY=andywu719

# AWS ECR (例如: 123456789012.dkr.ecr.us-west-2.amazonaws.com)
# DOCKER_REGISTRY=andywu719

# GitHub Container Registry (例如: ghcr.io/your-username)
# DOCKER_REGISTRY=andywu719

# Google Container Registry (例如: gcr.io/your-project-id)
# DOCKER_REGISTRY=andywu719

# Image Tag
IMAGE_TAG=latest

# 自定義服務 Images（將自動使用上面的 DOCKER_REGISTRY）
DIFY_API_IMAGE=${DOCKER_REGISTRY}/dify-api:${IMAGE_TAG}
DIFY_NEXT_FRONTEND_IMAGE=${DOCKER_REGISTRY}/dify-next-frontend:${IMAGE_TAG}
REST_TO_SOAP_PROXY_IMAGE=${DOCKER_REGISTRY}/rest-to-soap-proxy:${IMAGE_TAG}

# 構建相關配置
BUILD_NO_CACHE=false
